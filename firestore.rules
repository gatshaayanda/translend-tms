rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOrgMember(orgId) { return isSignedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'; }
    function memberRole(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role; }
    function canManageMembers(orgId) { return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager']; }
    function canEditOperations(orgId) { return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager', 'dispatcher', 'fleet_manager']; }
    function canEditFinance(orgId) { return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'finance']; }
    function isOwner(orgId) { return isOrgMember(orgId) && memberRole(orgId) == 'owner'; }
    function validClientCreate(orgId) {
      return request.resource.data.orgId == orgId
        && request.resource.data.environment == 'LIVE'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.deletedAt == null;
    }
    function preservesRecordEnvelope() {
      return request.resource.data.orgId == resource.data.orgId
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.deletedAt == resource.data.deletedAt
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function clientUpdateExcludes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }
    function validJobCreate(orgId) {
      return validClientCreate(orgId)
        && request.resource.data.status == 'confirmed'
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && exists(/databases/$(database)/documents/organizations/$(orgId)/customers/$(request.resource.data.customerId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/customers/$(request.resource.data.customerId)).data.environment == 'LIVE'
        && get(/databases/$(database)/documents/organizations/$(orgId)/customers/$(request.resource.data.customerId)).data.deletedAt == null
        && request.resource.data.customerName == get(/databases/$(database)/documents/organizations/$(orgId)/customers/$(request.resource.data.customerId)).data.name
        && request.resource.data.rate is number
        && request.resource.data.rate > 0
        && request.resource.data.cargoWeightTons is number
        && request.resource.data.cargoWeightTons >= 0
        && request.resource.data.requestedPickupDate is timestamp
        && request.resource.data.requestedDeliveryDate is timestamp
        && request.resource.data.requestedDeliveryDate >= request.resource.data.requestedPickupDate;
    }

    match /users/{uid} { allow read, write: if isSignedIn() && request.auth.uid == uid; }
    match /workspaceInvites/{inviteId} { allow read, write: if false; }
    match /{path=**}/members/{memberUid} { allow read: if isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'active'; }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(orgId);
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isSignedIn() && ((memberUid == request.auth.uid && resource.data.uid == request.auth.uid && resource.data.status == 'active') || isOrgMember(orgId));
        allow create: if isSignedIn() && ((memberUid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.orgId == orgId && request.resource.data.role == 'owner' && request.resource.data.status == 'active') || canManageMembers(orgId));
        allow update: if canManageMembers(orgId) && memberUid != request.auth.uid;
        allow delete: if false;
      }

      match /notifications/{docId} {
        allow read: if isOrgMember(orgId) && resource.data.recipientUid == request.auth.uid;
        allow update: if isOrgMember(orgId) && resource.data.recipientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'updatedAt', 'updatedBy']);
        allow create, delete: if false;
      }
      match /auditEvents/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }
      match /mutationReceipts/{docId} { allow read, create, update, delete: if false; }

      match /customers/{docId} { allow read: if isOrgMember(orgId); allow create: if (canEditOperations(orgId) || canEditFinance(orgId)) && validClientCreate(orgId); allow update: if (canEditOperations(orgId) || canEditFinance(orgId)) && preservesRecordEnvelope(); allow delete: if false; }
      match /trucks/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope() && clientUpdateExcludes(['status', 'assignedDriverId']); allow delete: if false; }
      match /drivers/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope() && clientUpdateExcludes(['status', 'assignedTruckId', 'linkedUid']); allow delete: if false; }
      match /jobs/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if canEditOperations(orgId) && validJobCreate(orgId);
        allow update: if canEditOperations(orgId) && preservesRecordEnvelope()
          && (resource.data.status == 'confirmed' || clientUpdateExcludes(['customerId', 'customerName', 'rate', 'currency', 'requestedPickupDate', 'requestedDeliveryDate']))
          && clientUpdateExcludes(['status']);
        allow delete: if false;
      }

      match /trips/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }
      match /deliveries/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }
      match /deliveryNotes/{docId} {
        allow read: if isOrgMember(orgId);
        allow create: if false;
        allow update: if canEditOperations(orgId) && preservesRecordEnvelope() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noteReference', 'customerName', 'suppliedTo', 'deliveryLocation', 'orderReference', 'podReference', 'loadingPoint', 'receivedByName', 'notes', 'materialLines', 'updatedAt', 'updatedBy']);
        allow delete: if false;
      }
      match /deliveryExceptions/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }

      match /fuelLogs/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }
      match /invoices/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }
      match /journalEntries/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }
      match /invoicePayments/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }
      match /supplierBills/{docId} { allow read: if isOrgMember(orgId); allow create, update, delete: if false; }

      match /workOrders/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope(); allow delete: if false; }
      match /supplierPOs/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope(); allow delete: if false; }
      match /truckLocationEvents/{docId} { allow read: if isOrgMember(orgId); allow create: if isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager', 'dispatcher', 'fleet_manager', 'driver'] && validClientCreate(orgId); allow update: if isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager', 'dispatcher', 'fleet_manager', 'driver'] && preservesRecordEnvelope(); allow delete: if false; }
      match /tripMetrics/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope(); allow delete: if false; }
      match /maintenanceSchedules/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope(); allow delete: if false; }
      match /vehicleInspections/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope(); allow delete: if false; }
      match /tyreRecords/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditOperations(orgId) && validClientCreate(orgId); allow update: if canEditOperations(orgId) && preservesRecordEnvelope(); allow delete: if false; }
      match /chartAccounts/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditFinance(orgId) && validClientCreate(orgId); allow update: if canEditFinance(orgId) && preservesRecordEnvelope(); allow delete: if false; }
      match /accountingPeriods/{docId} { allow read: if isOrgMember(orgId); allow create: if canEditFinance(orgId) && validClientCreate(orgId); allow update: if canEditFinance(orgId) && preservesRecordEnvelope(); allow delete: if false; }
    }
  }
}
