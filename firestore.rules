rules_version = '2';

// =============================================================
// Translend TMS · Firestore security rules
// =============================================================
// Enforces:
//   - a user can only read/write their own /users/{uid} doc
//   - org data is only readable/writable by active members of
//     that org (checked via the org's /members/{uid} subdoc)
//   - only Owner/Operations Manager can invite/edit members
//   - business collections are member-read, and write-gated by
//     role via editOperations/editFinance (mirrors ROLE_PERMISSIONS
//     in src/types/core.ts — keep these in sync by hand)

function isSignedIn() {
  return request.auth != null;
}

function isOrgMember(orgId) {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
}

function memberRole(orgId) {
  return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
}

function canManageMembers(orgId) {
  return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager'];
}

function canEditOperations(orgId) {
  return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager', 'dispatcher', 'fleet_manager'];
}

function canEditFinance(orgId) {
  return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'finance'];
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Collection-group discovery: authenticated users may discover only their own membership documents.
    // Required before the app knows which organization the user belongs to.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && memberUid == request.auth.uid;
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      // Creation happens client-side by an authenticated user
      // creating themself as Owner in the same transaction as the
      // first member doc — so we allow create by any signed-in
      // user, but only if they are also creating their own Owner
      // membership (validated by the members rule below).
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOrgMember(orgId) && memberRole(orgId) == 'owner';
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);
        allow create: if isSignedIn() && (
          // first member ever created must be the owner, creating themself
          (memberUid == request.auth.uid && request.resource.data.role == 'owner') ||
          canManageMembers(orgId)
        );
        allow update, delete: if canManageMembers(orgId);
      }

      match /customers/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if canEditOperations(orgId) || canEditFinance(orgId);
        allow delete: if false; // soft delete only, via update
      }

      match /trucks/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if canEditOperations(orgId);
        allow delete: if false;
      }

      match /drivers/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if canEditOperations(orgId);
        allow delete: if false;
      }

      match /jobs/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if canEditOperations(orgId);
        allow delete: if false;
      }

      match /trips/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if canEditOperations(orgId);
        allow delete: if false;
      }

      match /deliveries/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if canEditOperations(orgId);
        allow delete: if false;
      }
    }
  }
}
