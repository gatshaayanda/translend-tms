rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function isOrgMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function memberRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    function canManageMembers(orgId) {
      return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager'];
    }

    function canEditOperations(orgId) {
      return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'operations_manager', 'dispatcher', 'fleet_manager'];
    }

    function canEditFinance(orgId) {
      return isOrgMember(orgId) && memberRole(orgId) in ['owner', 'finance'];
    }

    function isOwner(orgId) {
      return isOrgMember(orgId) && memberRole(orgId) == 'owner';
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'active';
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(orgId);
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isSignedIn() && ((memberUid == request.auth.uid && resource.data.uid == request.auth.uid && resource.data.status == 'active') || isOrgMember(orgId));
        allow create: if isSignedIn() && ((memberUid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.orgId == orgId && request.resource.data.role == 'owner' && request.resource.data.status == 'active') || canManageMembers(orgId));
        allow update: if canManageMembers(orgId) && (memberUid != request.auth.uid || (resource.data.role == request.resource.data.role && resource.data.status == request.resource.data.status));
        allow delete: if false;
      }

      match /customers/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if canEditOperations(orgId) || canEditFinance(orgId);
        allow delete: if false;
      }
      match /trucks/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /drivers/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /jobs/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /trips/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /deliveries/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /deliveryNotes/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /deliveryExceptions/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }

      match /fuelLogs/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /workOrders/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /supplierPOs/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /invoices/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditFinance(orgId); allow delete: if false; }
      match /journalEntries/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditFinance(orgId); allow delete: if false; }

      // Phase 2: persisted operational intelligence. Same operational role boundary as trips/fuel.
      match /tripMetrics/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }

      // Phase 3: workshop control domains. Same operational role boundary as work orders.
      match /maintenanceSchedules/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /vehicleInspections/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
      match /tyreRecords/{docId} { allow read: if isOrgMember(orgId); allow create, update: if canEditOperations(orgId); allow delete: if false; }
    }
  }
}
